{
  "name": "@agentdeploy/sdk",
  "version": "0.1.0",
  "description": "Whitelabelled SDK for deploying and invoking AI agents on AgentDeploy Edge.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agentdeploy",
    "ai-agents",
    "cloudflare-workers",
    "edge",
    "sdk"
  ],
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
