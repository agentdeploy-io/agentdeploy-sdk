{
  "name": "@agentdeploy-io/edge-sdk",
  "version": "0.2.0",
  "description": "Build AI agents on Cloudflare's edge with AgentDeploy billing, telemetry, and gateway integration.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agentdeploy",
    "cloudflare-agents",
    "ai-agents",
    "edge",
    "durable-objects",
    "workers"
  ],
  "dependencies": {
    "@agentdeploy-io/agents": "^0.2.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/openai-compatible": "^1.0.46",
    "@cloudflare/ai-chat": "^0.9.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "agents": "^0.20.1",
    "ai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.7.0"
  }
}