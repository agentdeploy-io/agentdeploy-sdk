# ─── LLM ──────────────────────────────────────────────────────────
# Option 1 (preferred): any OpenAI-compatible gateway/relay — base URL + token.
# Without a config the server still boots; LLM calls fail with a clear error.
LLM_BASE_URL=
LLM_API_KEY=
# Model id served by the gateway (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
# Aliases also honored: OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL

# Option 2: Anthropic direct (default model claude-sonnet-4-5)
ANTHROPIC_API_KEY=
# CALLA_MODEL=claude-sonnet-4-5

# ─── Storage ──────────────────────────────────────────────────────
# TWO stores share this config:
#   1. Mastra storage (agent runs, suspended snapshots, memory)
#   2. Durable Calla store (calla_* tables: approvals history, hash-chained
#      audit log, agent registry, TTL cache) — presence-driven selection
#      (pattern adapted from @elizaos/plugin-sql, MIT):
#        isRealPostgresUrl(DATABASE_URL) → Postgres (drizzle-orm + pg)
#        else                            → LibSQL at LIBSQL_URL ?? file:local.db
#      :memory:/sqlite/file:*.db values in DATABASE_URL are REJECTED and fall
#      back to LibSQL. GET /health reports both: storage + callaStore.

# Postgres (Fly.io production). When unset (or not a real pg URL), both
# stores fall back to local LibSQL.
DATABASE_URL=
# LibSQL fallback URL (default: file:local.db). Use libsql://... for Turso.
LIBSQL_URL=file:local.db

# ─── Edge runtime ─────────────────────────────────────────────────
# Calla edge worker (Cloudflare) base URL used by dispatch-edge-task/list-fleet.
CALLA_EDGE_URL=http://127.0.0.1:8787

# ─── Auth ─────────────────────────────────────────────────────────
# Static service token. When set, every route except /health, / and /auth/*
# accepts `Authorization: Bearer <CALLA_TOKEN>`. Used by relays/service callers.
# When unset (and CALLA_JWT_SECRET unset) the API is open (local dev only).
CALLA_TOKEN=

# ─── Self-hosted (standalone) auth ────────────────────────────────
# Shared HMAC secret for the brain-issued HS256 JWTs. The SAME value MUST be
# set on the edge worker (CALLA_JWT_SECRET) so it can verify user tokens.
# Generate one with:  openssl rand -hex 32
# When set, protected routes also accept `Authorization: Bearer <Calla JWT>`,
# and /auth/register + /auth/login issue tokens. When unset, /auth/* generates
# an EPHEMERAL secret (tokens invalidate on every restart — dev only).
CALLA_JWT_SECRET=
# Optional access-token lifetime in days (default 7).
# CALLA_AUTH_TTL_DAYS=7

# Secondary approver for the escalation workflow (stub logs only for now).
# CALLA_SECONDARY_APPROVER=ops@example.com

# ─── HTTP ─────────────────────────────────────────────────────────
PORT=3000

# ─── Channels (Telegram / WhatsApp) ───────────────────────────────
# A platform is enabled iff its required vars are present. Full guide:
# src/channels/README.md
# Telegram: token from @BotFather. No TELEGRAM_WEBHOOK_URL → long-polling (dev-friendly).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_WEBHOOK_URL=https://brain.example.com/channels/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# CUSTOMER MODE (default true): messages from chats that are NOT bound
# operators are treated as customer conversations — captured as leads
# (WA:<phone>), matched against social triggers, and handed to the
# qualification-flow engine (channel "whatsapp"). Bound operator chats keep
# the console behavior exactly. Set to "false" to disable (operator-only).
WHATSAPP_CUSTOMER_MODE=true
# Edge /events feed the notifier subscribes to (default: CALLA_EDGE_URL or http://127.0.0.1:8787)
# CHANNELS_EDGE_EVENTS_URL=
# Loopback base for mastra approval decisions (default http://127.0.0.1:$PORT)
# CHANNELS_BRAIN_LOOPBACK=

# ─── Social channels (Instagram + TikTok) ─────────────────────────
# ManyChat-style reply automation for BUSINESS social accounts, via the OFFICIAL
# Meta + TikTok business APIs. Full guide: src/channels/README.md
# ("Instagram & TikTok (social)"). A platform is enabled iff its access token is set.

# Instagram — "Instagram API with Instagram Login" (base graph.instagram.com/v21.0).
# Meta app type "Instagram Login"; permissions instagram_business_basic +
# instagram_business_manage_messages (Advanced Access needs App Review).
IG_APP_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
# Long-lived user token (see POST /channels/instagram/exchange). Presence ENABLES Instagram.
IG_ACCESS_TOKEN=
# Override for the legacy graph.facebook.com mode or a local mock (tests).
# IG_API_BASE=https://graph.instagram.com/v21.0
# Comment "private reply" path template ({commentId} is substituted).
# IG_PRIVATE_REPLY_PATH={commentId}/private_replies
# Redirect URI used by the code→token exchange helper.
# IG_REDIRECT_URI=

# TikTok — Business Messaging API (Login Kit v2 OAuth); REQUIRES a Business account.
# ⚠ Automation only in USER-INITIATED conversations; comment-to-message is
#   REGION-GATED (partial SEA; NOT available EEA/UK/CH). Presence ENABLES TikTok.
TIKTOK_ACCESS_TOKEN=
TIKTOK_VERIFY_TOKEN=
# Webhook handshake: "challenge" (GET hub.challenge echo, default) or "body" (token in POST body).
# TIKTOK_WEBHOOK_MODE=challenge
# ⚠ Endpoint paths are UNVERIFIED without keys — confirm in the TikTok developer portal.
# TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3
# TIKTOK_SEND_PATH=im/dm/send/
# TIKTOK_ADVERTISER_ID=
# TIKTOK_BC_ID=

# Persona agent that drafts social replies (dynamic, store-editable). Default "miles".
SOCIAL_REPLY_AGENT=miles
# Lead capture → bi-edge /inbound/sync pipeline (POST {leads:[…]}, header X-AD-Sync).
SOCIAL_ENGINE_SYNC_URL=
SOCIAL_ENGINE_SYNC_SECRET=
# Capture every social enquiry as a lead (default true). First contact → full
# sync (stage raw / status pending_review); subsequent contacts → partial
# patch only (never downgrades an approved/sent lead).
SOCIAL_LEAD_CAPTURE=true
# Optional override for the engine's data API origin (/cmd/data/row patches).
# Defaults to SOCIAL_ENGINE_SYNC_URL minus the /inbound/sync suffix.
SOCIAL_ENGINE_DATA_URL=

# ─── Meta Lead Forms (Facebook/Instagram Lead Ads) ────────────────
# Webhook at GET|POST /channels/facebook/webhook (subscribe the "leadgen"
# field). Full guide: src/channels/README.md → "Meta Lead Forms + website widget".
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
# Token with leads_retrieval (Page/system-user) — fetches the full lead.
# Unset → webhook is acknowledged (200) but leads cannot be fetched (audited).
FACEBOOK_ACCESS_TOKEN=
# Graph base (override for mocks).
# FB_GRAPH_BASE=https://graph.facebook.com/v21.0
# Flow started per lead (prefilled via the field map). "none" disables.
FACEBOOK_LEADGEN_FLOW=retrofit-solar-qualification
# Optional JSON override of the seeded form-question → flow-field map
# (cache key "leadform:fieldmap"), e.g. {"Property type":"property_type"}
# FACEBOOK_FIELD_MAP=
# Country stamped on captured leads.
FB_LEAD_COUNTRY=IE

# ─── Embeddable website form (/forms/*) ───────────────────────────
# Public by design (widget.js + definition + ingest). Comma-separated CORS
# origin allowlist; unset → "*" (any site may embed). Ingest is rate-limited
# 10/min per IP (in-memory).
FORMS_ALLOWED_ORIGINS=

# ─── Qualification flows (src/flows) ──────────────────────────────
# Deterministic-first: answers are matched by rule (choice ordinals/substring,
# yes/no tokens, Eircode/email regexes). Optional LLM fallback: when true AND
# a text/number answer doesn't parse, resolveDynamicAgent(SOCIAL_REPLY_AGENT)
# is asked for a strict-JSON value extraction (failures store the raw text).
FLOWS_LLM_EXTRACT=false
# Flow completion patches the engine lead (classification + merged research)
# via the SOCIAL_ENGINE_* data-plane config above, and relays urgent/routed
# calla:message frames to CALLA_EDGE_URL /events/ingest (see Edge runtime).

# ─── Booking (Google / Microsoft 365 / Calendly) ──────────────────
# Appointment booking for survey reps (Ireland; default tz Europe/Dublin).
# A provider is usable iff its credentials are set. Full guide: README.md
# → "Booking (Google / Microsoft 365 / Calendly)".

# Public base URL of this brain (used for OAuth redirect defaults + webhook/
# watch registration). Defaults to http://localhost:$PORT when unset.
# BOOKING_PUBLIC_URL=https://brain.example.com

# Google — Cloud Console → APIs & Services → Credentials → OAuth client
# (enable the Google Calendar API). Presence of id+secret enables /connect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the authorized redirect URI registered with Google exactly.
# GOOGLE_REDIRECT_URI=https://brain.example.com/booking/connect/google/callback

# Microsoft 365 — Entra ID (Azure) app registration with the delegated
# Calendars.ReadWrite, offline_access and User.Read permissions + a redirect
# URI for /booking/connect/microsoft/callback + a client secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant id (or leave "common" for multi-tenant orgs).
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=https://brain.example.com/booking/connect/microsoft/callback
# Graph subscription clientState (defaults to BOOKING_WEBHOOK_SECRET).
# MICROSOFT_CLIENT_STATE=

# Calendly — NO OAuth needed: link each rep's scheduling URL via
# POST /booking/connect/calendly/link and create a webhook (invitee.created +
# invitee.canceled) pointing at /booking/webhook/calendly with a signing
# secret (Webhooks → secret; sent as the X-Signature hex HMAC-SHA256).
CALENDLY_WEBHOOK_SECRET=
# Optional personal access token — only for API cancels/lookups.
# CALENDLY_ACCESS_TOKEN=

# Shared booking webhook secret: Google channel token (X-Goog-Channel-Token)
# and default Graph clientState. Generate: openssl rand -hex 32
BOOKING_WEBHOOK_SECRET=

# API base overrides (mock testing — point at local fake servers; see README).
# GOOGLE_API_BASE=https://www.googleapis.com
# GOOGLE_OAUTH_BASE=https://accounts.google.com
# GOOGLE_OAUTH_TOKEN_BASE=https://oauth2.googleapis.com
# GRAPH_API_BASE=https://graph.microsoft.com/v1.0
# MICROSOFT_OAUTH_BASE=https://login.microsoftonline.com

# ─── Dual booking backend (native module OR external Google Calendar MCP) ──
# Calla can serve booking two ways, selectable per deployment:
#   native (default) — Calla's own booking module (Google/M365/Calendly above)
#   mcp              — proxy to an EXTERNAL Google Calendar MCP server below
#   both             — native first; fall back to external MCP on connectivity
#                      gaps (not-connected / no tool). Both the REST /booking
#                      routes AND the Calla-hosted /mcp/booking server honour
#                      this switch — one booking core, two protocols.
# BOOKING_BACKEND=native

# External Google Calendar MCP server (used when BOOKING_BACKEND=mcp|both).
# Any MCP Streamable-HTTP server exposing calendar tools works.
# EXTERNAL_CALENDAR_MCP_URL=https://calendar-mcp.example.com/mcp
# EXTERNAL_CALENDAR_MCP_TOKEN=            # sent as Authorization: Bearer
# EXTERNAL_MCP_TIMEZONE=Europe/Dublin
# Optional explicit tool-name mapping (else heuristic match on the tool list):
# EXTERNAL_MCP_TOOL_AVAILABILITY=
# EXTERNAL_MCP_TOOL_BOOK=
# EXTERNAL_MCP_TOOL_LIST=
# EXTERNAL_MCP_TOOL_CANCEL=
# EXTERNAL_MCP_TOOL_REPS=

# Calla-hosted Booking MCP SERVER (standard MCP Streamable HTTP at
# /mcp/booking) — exposes the selected backend as MCP tools so Mastra agents
# (@mastra/mcp), the voice agent, Claude Desktop or Cursor can book through the
# SAME core + audit trail. Behind bearer auth. Set false to disable the surface.
# BOOKING_MCP_ENABLED=true
# CALENDLY_API_BASE=https://api.calendly.com
