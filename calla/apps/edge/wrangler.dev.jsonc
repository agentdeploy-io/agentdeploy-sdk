{
  // Local dev config WITHOUT the Workers AI binding. In wrangler 4.147+ the
  // AI binding is REMOTE-only, so `wrangler dev` needs CF auth (wrangler
  // login / CLOUDFLARE_API_TOKEN) to boot with it. scripts/dev.mjs falls back
  // to this file automatically when no CF auth is available: the voice DO
  // detects env.AI missing and disables STT/TTS for calls, everything else
  // (agents, events, data plane, telnyx bridge) runs unchanged.
  "name": "calla-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CALLA_EDGE_AGENT", "class_name": "CallaEdgeAgent" },
      { "name": "CALLA_ORCHESTRATOR", "class_name": "CallaOrchestrator" },
      { "name": "CALLA_EVENTS", "class_name": "CallaEventHub" },
      // Binding name MUST equal the class name: the /telnyx/stream bridge
      // resolves the namespace via env["CallaVoiceAgent"].
      { "name": "CallaVoiceAgent", "class_name": "CallaVoiceAgent" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CallaEdgeAgent", "CallaOrchestrator", "CallaEventHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CallaVoiceAgent"]
    }
  ],
  "workflows": [
    { "name": "calla-approval-workflow", "class_name": "CallaApprovalWorkflow", "binding": "CALLA_APPROVAL_WORKFLOW" }
  ]
}
