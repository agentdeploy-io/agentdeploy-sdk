{
  "name": "@agentdeploy-io/bi-core",
  "version": "0.1.0",
  "private": true,
  "description": "Website matching v2 system for business intelligence agent — candidate discovery, verification, scoring, and contact extraction with Mastra workflows.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@mastra/core": "^0.13.0",
    "adm-zip": "^0.5.10",
    "cheerio": "^1.0.0",
    "crawlee": "^3.12.0",
    "playwright": "^1.64.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
