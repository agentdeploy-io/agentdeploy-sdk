# Copy to .env for local `npm start` (git-ignored — never commit real keys).
# Loaded by server.ts (real environment variables always win).
# Full pipeline explanation: see packages/bi-edge/README.md

# HTTP port for the crawler server
PORT=4111

# Checkpoint/watermark dir (must be writable; /data is the Railway default)
DATA_DIR=/tmp/calla-bi-core-data

# UK Companies House API key (basic auth — key as username, empty password)
COMPANIES_HOUSE_KEY=

# Sync harvested leads back to the bi-edge engine.
# SYNC_SECRET MUST match AD_SYNC_SECRET in packages/bi-edge/.dev.vars
SYNC_URL=http://127.0.0.1:8792
SYNC_SECRET=

# Brave Search API (website discovery). Free: 2,000 queries/mo.
BRAVE_API_KEY=
