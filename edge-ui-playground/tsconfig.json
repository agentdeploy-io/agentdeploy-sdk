{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@agentdeploy/edge-ui/*": ["../edge-ui/src/*"],
      "@agentdeploy/edge-ui": ["../edge-ui/src/index.ts"]
    }
  },
  "include": ["src"]
}
