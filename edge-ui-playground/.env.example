# ──────────────────────────────────────────────────────────────────
# AgentDeploy Edge Console — Environment Configuration
# ──────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local dev or `.env.production` for builds.
#
# In local dev, ALL of these can be left unset — auth auto-disables
# on localhost and agents are served via the Vite dev proxy.
#
# For production deployment, see DEPLOY.md.

# ─── Auth ─────────────────────────────────────────────────────────

# Disable auth entirely (auto-detected on localhost).
# Set to "true" for testing without auth, "false" to force-enable.
# Default: auto (true on localhost, false everywhere else)
VITE_AUTH_DISABLED=

# ─── Marketplace ──────────────────────────────────────────────────

# The main AgentDeploy marketplace URL.
# Buyers log in here. Token exchange redirects here for custom domains.
# Default: https://agentdeploy.io
VITE_MARKETPLACE_URL=https://agentdeploy.io

# ─── Deployment Service ───────────────────────────────────────────

# The deployment-service API base URL.
# The console fetches the buyer's purchased templates from here.
# In production: https://api.agentdeploy.io
# In local dev: not needed (hardcoded agents are used)
VITE_DEPLOYMENT_API_URL=https://api.agentdeploy.io

# ─── Cloudflare Deployment (wrangler.toml vars, not VITE_ prefixed) ──

# Your Cloudflare account ID (for wrangler deploy).
# Find at: https://dash.cloudflare.com → Workers & Pages → right sidebar
CF_ACCOUNT_ID=

# The buyer's subdomain handle (auto-generated by marketplace).
# Example: "acme" → acme.agentdeploy.io
BUYER_HANDLE=

# The buyer's hosting tier (determines agent limits and domain type).
# One of: sandbox | starter | pro | business
BUYER_TIER=starter
