{
  "name": "@agentdeploy/cli",
  "version": "0.1.0",
  "description": "CLI for building and deploying edge agents on AgentDeploy.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ad": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agentdeploy",
    "cli",
    "cloudflare-agents",
    "edge",
    "ai-agents"
  ],
  "dependencies": {
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
